# Copy this file to worker/kindle-converter/.env and fill it. That .env is not committed
# (.env files are ignored by git); the keys stay in it, never in the code.

# Same Supabase project as the BFF (Vercel). Only the queue and the link to each AZW3 go there.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SECRET_KEY=

# Google Drive: the AZW3s go to the folder "Lumeo Kindle AZW3" of the account that owns the
# catalog. OAuth client of type "Desktop app" (Google Cloud Console > APIs & Services >
# Credentials), Drive API enabled. Then run once: npm run worker:kindle:drive-auth
# (it fills KINDLE_DRIVE_REFRESH_TOKEN below by itself).
KINDLE_DRIVE_CLIENT_ID=
KINDLE_DRIVE_CLIENT_SECRET=
KINDLE_DRIVE_REFRESH_TOKEN=

# Optional (defaults shown)
# KINDLE_DRIVE_FOLDER_NAME=Lumeo Kindle AZW3
# KINDLE_DRIVE_FOLDER_ID=            (an existing folder created by this worker; found by name otherwise)
# OPDS_AUTOAJUDA_FOLDER_ID=1Pqu3DcMJT8wTwC7pFX7e20Z9fPUDJBoZ
# KINDLE_SCAN_INTERVAL_MINUTES=30
# KINDLE_IDLE_SECONDS=60
# KINDLE_MAX_ATTEMPTS=3
# KINDLE_MAX_EPUB_MB=200
# KINDLE_CONVERT_TIMEOUT_SECONDS=900
