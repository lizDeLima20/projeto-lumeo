# Supabase production project URL. This value is public; keys below must stay in env only.
SUPABASE_URL=https://rasonfawfsvyfhjkinbp.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# Backend/BFF secret key. Must never use VITE_ and must never be committed.
SUPABASE_SECRET_KEY=

# Temporary compatibility fallback only. Prefer SUPABASE_SECRET_KEY above.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Runtime environment
APP_ENV=development
APP_VERSION=0.1.0
APP_BASE_URL=http://localhost:5173
BFF_BASE_URL=http://127.0.0.1:3000/api

# Long random secret used only by the backend when hashing installation IDs
DEVICE_HASH_SECRET=
# Temporary test-only bypass. Set true deliberately in Vercel only while
# validating development accounts; turn it back to false for paid licensing.
AUTO_ACTIVATE_DEV_LICENSE=false
# With no Supabase credentials, local auth is enabled by default in development.
LOCAL_AUTH_MODE=false
NODE_ENV=development
PORT=3000
# Production also accepts Capacitor's secure local WebView origin.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost

# Public frontend variables. sb_publishable_* is allowed; sb_secret_* is forbidden in VITE_*.
VITE_SUPABASE_URL=https://rasonfawfsvyfhjkinbp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Temporary compatibility fallback only. Prefer VITE_SUPABASE_PUBLISHABLE_KEY above.
VITE_SUPABASE_ANON_KEY=
# Local only. Production always uses the same-origin /api Vercel function.
VITE_API_URL=http://localhost:3000/api
# Android Capacitor build only. This public HTTPS BFF URL is required because
# the native WebView's localhost is not the Vercel same-origin deployment.
VITE_CAPACITOR_API_URL=

# Google Cloud Console: credenciais públicas para Google Picker e Identity Services.
# Em Production, defina VITE_GOOGLE_CLIENT_ID no projeto Vercel (não é segredo).
# Habilite Google Drive API no mesmo projeto OAuth e autorize as origens
# https://lumeo-livros.vercel.app e http://localhost:5173 no cliente Web.
# O Lumeo não usa client secret no navegador.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# Server-only Google Drive account used for the authorised remote catalogue.
# Share only the catalogue folder with this service-account email. Store the
# complete JSON key as a Vercel secret (plain JSON or base64 JSON); never VITE_.
GOOGLE_CATALOG_FOLDER_ID=
# Optional hybrid public-source registry. Keep legacy folders in legacy mode;
# add controlled folders in auto/structured mode without migrating old shares.
# GOOGLE_CATALOG_SOURCES_JSON=[{"sourceId":"legacy-br-01","locale":"pt-BR","folderId":"...","mode":"legacy","enabled":true,"priority":10},{"sourceId":"pt-br-02","locale":"pt-BR","folderId":"...","mode":"auto","enabled":true,"priority":20}]
GOOGLE_CATALOG_SERVICE_ACCOUNT_JSON=
# Maximum file size accepted during an explicit administrator sync (100 MiB).
CATALOG_SYNC_MAX_FILE_BYTES=104857600

# Microsoft Entra SPA (public identifiers only). No client secret is needed.
# Register /onedrive-auth.html as a SPA redirect on each allowed app origin.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=common
VITE_ONEDRIVE_ENABLED=false
