{
  "name": "lumeo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/local.ts",
    "dev:all": "concurrently -n web,api \"npm:dev\" \"npm:dev:server\"",
    "build": "npm run ocr:assets && npm run typecheck && vite build && npm run build:server",
    "build:android": "npm run ocr:assets && npm run typecheck && vite build --mode android && npm run build:server",
    "build:server": "tsc -p server/tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "test:server": "tsx --test server/tests/*.test.ts",
    "test:storage": "tsx --test tests/*.test.ts",
    "test": "npm run test:server && npm run test:storage",
    "smoke:supabase": "sh -c 'if [ -f .env ]; then node --env-file=.env --import tsx server/src/supabaseSmoke.ts; else node --import tsx server/src/supabaseSmoke.ts; fi'",
    "audit:catalog": "sh -c 'if [ -f .env ]; then node --env-file=.env --import tsx server/src/catalogAudit.ts; else node --import tsx server/src/catalogAudit.ts; fi'",
    "ocr:assets": "node scripts/ocr-assets.mjs",
    "preview": "vite preview",
    "android:java": "./scripts/android-terminal.sh java",
    "android:sync": "./scripts/android-terminal.sh sync",
    "android:build": "./scripts/android-terminal.sh build",
    "android:install": "./scripts/android-terminal.sh install",
    "android:logs": "./scripts/android-terminal.sh logs",
    "android:dev": "./scripts/android-terminal.sh dev",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@azure/msal-browser": "^4.30.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@fontsource-variable/literata": "^5.3.0",
    "@lingo-reader/mobi-parser": "^0.4.6",
    "@supabase/supabase-js": "^2.57.0",
    "fflate": "^0.8.3",
    "html2canvas": "^1.4.1",
    "pdfjs-dist": "^6.3.289",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.1",
    "fake-indexeddb": "^6.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  }
}
